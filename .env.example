# Copy to .env and replace every change-me value before starting the stack.
#   cp .env.example .env
#
# Upstream provider API keys are not read from the environment. After you log
# in, add them under a project (Providers). They are encrypted with
# FERNET_MASTER_KEY and stored in Postgres. Paste placeholders only in the UI:
#   openai      sk-replace-me
#   anthropic   sk-ant-replace-me

# --- Postgres (also interpolated by docker-compose.yml) ---
# Any name is fine. The database is created on first boot.
POSTGRES_USER=aegis
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=aegisllm
# "db" is the compose service name. Use localhost if you run the app on the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
# Compose service name. Use redis://localhost:6379/0 for a host-run app.
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_NAME=AegisLLM
# development enables /docs. production hides it.
ENVIRONMENT=production
DEBUG=false
# Comma-separated browser origins for the dashboard.
ALLOWED_ORIGINS=http://localhost
# Set to false once the first admin account exists.
ALLOW_REGISTRATION=true

# openssl rand -hex 32
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=change-me-generate-a-fernet-key

# Exact hostnames the proxy is allowed to connect to. No wildcards.
ALLOWED_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com
# Comma-separated CIDRs that may be private (a self-hosted model server). Empty blocks all of them.
UPSTREAM_PRIVATE_IP_ALLOWLIST=
PROXY_REQUEST_TIMEOUT_SEC=120
MAX_REQUEST_BODY_BYTES=2097152

# Per API key. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=60

# --- Retention (UTC) ---
CLEANUP_HOUR_UTC=3
CLEANUP_MINUTE_UTC=0
# 0 keeps audit_logs forever. Payload bodies follow each project's retention_days.
AUDIT_LOG_RETENTION_DAYS=90
CLEANUP_BATCH_SIZE=1000

# --- Payload privacy ---
# true stores the unmasked request and response next to the masked copy.
STORE_RAW_PAYLOADS=false
# Comma-separated emails allowed to pass include_raw=true. Empty means nobody.
ADMIN_EMAILS=

# --- Caddy (Caddyfile {$DOMAIN}) ---
# Public hostname for automatic HTTPS. localhost keeps the local HTTP listener.
DOMAIN=localhost
